{
  "expo": {
    "name": "DespesApp",
    "slug": "despesapp",
    "version": "0.2.1",
    "icon": "./assets/kikki_icon.png",
    "splash": {
      "image": "./assets/kikki_splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#181520"
    },
    "newArchEnabled": true,
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/68c68e08-9318-43cd-a1bc-c84554a8f39c"
    },
    "assetBundlePatterns": ["**/*"],
    "scheme": "cat.aurruti.despesapp",
    "platforms": ["ios", "android"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "cat.aurruti.despesapp"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/kikki_icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "cat.aurruti.despesapp",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "https",
              "host": "despesapp.naidd.duckdns.org",
              "pathPrefix": "/callback",
              "pathPattern": ".*"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/kikki_icon.png"
    },
    "extra": {
      "eas": {
        "projectId": "68c68e08-9318-43cd-a1bc-c84554a8f39c"
      }
    },
    "owner": "aurruti",
    "plugins": ["expo-secure-store", "expo-asset"],
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
