{
  "expo": {
    "name": "DespesApp",
    "slug": "despesapp",
    "version": "0.0.1",
    "icon": "./assets/icon_prov.png",
    "splash": {
      "image": "./assets/images/placeholder.png",
      "resizeMode": "contain",
      "backgroundColor": "#181520"
    },
    "newArchEnabled": true,
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": ["**/*"],
    "scheme": "cat.aurruti.despesapp",
    "platforms": ["ios", "android"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "cat.aurruti.despesapp"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/placeholder.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "cat.aurruti.despesapp"
    },
    "web": {
      "favicon": "./assets/images/placeholder.png"
    },
    "extra": {
      "eas": {
        "projectId": "68c68e08-9318-43cd-a1bc-c84554a8f39c"
      }
    },
    "owner": "aurruti",
    "plugins": ["expo-secure-store", "expo-asset"]
  }
}
